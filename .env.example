# Variables de entorno para desarrollo/local
API_TOKEN=tu_token_aqui
PORT=3080

# Directorio donde se guardan los videos comprimidos (servidos en /files)
FILES_DIR=./files
# Minutos que vive cada video comprimido antes de borrarse
FILE_TTL_MINUTES=180
# Si es true, los videos se borran en cuanto se descargan (se puede
# sobrescribir por request con delete_after_download)
DELETE_AFTER_DOWNLOAD=false
# Tamaño máximo del body de texto en /pdf
TEXT_BODY_LIMIT=20mb

# Concurrencia de ffmpeg. Un encode satura todos los núcleos, así que varios a
# la vez hacen que todos tarden más y den timeout. 1 por cada 2 vCPU.
MAX_CONCURRENT_JOBS=1
# Cuántos pueden esperar en cola antes de responder 429
MAX_QUEUED_JOBS=4
# Núcleos por encode (0 = todos los disponibles)
FFMPEG_THREADS=0
# URL pública base para construir video_url (sin slash final).
# Si se omite, se deduce de los headers Host / X-Forwarded-*
PUBLIC_BASE_URL=https://audio-extract-vps.tail52e58c.ts.net
